generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 1. NOTIFICATION TEMPLATE
// ============================================================
enum TemplateType {
  EMAIL
  SMS
  PUSH
}

model NotificationTemplate {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(100)
  type      TemplateType @default(EMAIL)
  subject   String       @db.VarChar(255)
  body      String       @db.Text
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("notification_templates")
}

// ============================================================
// 2. DEVICE TOKEN
// ============================================================
model DeviceToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  token      String    @unique @db.VarChar(255)
  deviceType String?   @map("device_type") @db.VarChar(50)
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("device_tokens")
}

// ============================================================
// 3. APP NOTIFICATION (In-App Notification)
// ============================================================
enum AppNotificationType {
  BOOKING_CREATED
  BOOKING_CANCELLED
  BOOKING_CONFIRMED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PROMOTION
  SYSTEM
}

model AppNotification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  title     String              @db.VarChar(255)
  body      String              @db.Text
  type      AppNotificationType @default(SYSTEM)
  isRead    Boolean             @default(false) @map("is_read")
  data      Json?
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, isRead])
  @@map("app_notifications")
}

// ============================================================
// 4. NOTIFICATION LOGS
// ============================================================
enum LogStatus {
  PENDING
  SUCCESS
  FAILED
}

model EmailLog {
  id         String    @id @default(uuid()) @db.Uuid
  to         String    @db.VarChar(255)
  subject    String    @db.VarChar(255)
  template   String    @db.VarChar(100)
  status     LogStatus @default(PENDING)
  retryCount Int       @default(0) @map("retry_count")
  error      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("email_logs")
}

model SmsLog {
  id         String    @id @default(uuid()) @db.Uuid
  to         String    @db.VarChar(20)
  message    String    @db.Text
  status     LogStatus @default(PENDING)
  retryCount Int       @default(0) @map("retry_count")
  error      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("sms_logs")
}
