{
  "name": "notification-service",
  "version": "1.0.0",
  "description": "Microservice for managing and sending notifications triggered by RabbitMQ events",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "test:publish": "tsx scratch/test_publish.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@sendgrid/mail": "^8.1.4",
    "amqplib": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^12.0.0",
    "nodemailer": "^9.0.3",
    "twilio": "^5.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^7.8.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
