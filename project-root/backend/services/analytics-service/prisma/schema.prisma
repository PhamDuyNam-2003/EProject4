generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ReportType {
  DAILY
  MONTHLY
  YEARLY
}

enum ActivityType {
  BOOKING_CREATED
  BOOKING_CANCELLED
  PAYMENT_COMPLETED
  PAYMENT_REFUNDED
  USER_LOGIN
  USER_REGISTER
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Ghi log mọi hoạt động quan trọng của user (real-time từ RabbitMQ)
model UserActivityLog {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  activityType ActivityType @map("activity_type")
  referenceId  String?      @map("reference_id") @db.VarChar(100)  // bookingId / paymentId
  amount       Decimal?     @db.Decimal(15, 2)
  metadata     Json?        // Extra payload from event
  occurredAt   DateTime     @default(now()) @map("occurred_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([userId])
  @@index([activityType])
  @@index([occurredAt])
  @@map("user_activity_logs")
}

/// Báo cáo doanh thu tổng hợp theo ngày/tháng/năm
/// Idempotent: unique(reportDate, reportType) đảm bảo không lặp data
model RevenueReport {
  id               String     @id @default(uuid()) @db.Uuid
  reportDate       DateTime   @map("report_date") @db.Date
  reportType       ReportType @map("report_type")
  totalRevenue     Decimal    @default(0) @map("total_revenue") @db.Decimal(15, 2)
  bookingCount     Int        @default(0) @map("booking_count")
  cancelledCount   Int        @default(0) @map("cancelled_count")
  refundAmount     Decimal    @default(0) @map("refund_amount") @db.Decimal(15, 2)
  netRevenue       Decimal    @default(0) @map("net_revenue") @db.Decimal(15, 2)
  generatedAt      DateTime   @default(now()) @map("generated_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  /// Unique constraint để đảm bảo idempotency – upsert sẽ không tạo bản ghi trùng
  @@unique([reportDate, reportType])
  @@index([reportType])
  @@index([reportDate])
  @@map("revenue_reports")
}

/// Báo cáo doanh thu theo từng khách sạn (tổng hợp hàng ngày)
model HotelReport {
  id            String     @id @default(uuid()) @db.Uuid
  hotelId       String     @map("hotel_id") @db.Uuid
  reportDate    DateTime   @map("report_date") @db.Date
  reportType    ReportType @map("report_type")
  revenue       Decimal    @default(0) @db.Decimal(15, 2)
  bookingCount  Int        @default(0) @map("booking_count")
  averageRating Float      @default(0) @map("average_rating")
  generatedAt   DateTime   @default(now()) @map("generated_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@unique([hotelId, reportDate, reportType])
  @@index([hotelId])
  @@index([reportDate])
  @@map("hotel_reports")
}

/// Chống lặp job – ghi lại mỗi lần cron chạy
/// Nếu jobName + jobDate đã có status=SUCCESS → job mới sẽ bị skip
model JobExecutionLog {
  id              String    @id @default(uuid()) @db.Uuid
  jobName         String    @map("job_name") @db.VarChar(100)
  jobDate         DateTime  @map("job_date") @db.Date       // Ngày job này xử lý (không phải ngày chạy)
  status          JobStatus @default(RUNNING)
  executionTimeMs Int?      @map("execution_time_ms")
  recordsAffected Int?      @map("records_affected")
  errorMessage    String?   @map("error_message") @db.Text
  startedAt       DateTime  @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  /// Unique: mỗi job chỉ chạy thành công 1 lần / ngày
  @@unique([jobName, jobDate])
  @@index([jobName])
  @@index([status])
  @@map("job_execution_logs")
}
