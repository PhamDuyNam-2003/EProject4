// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AGENT
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
  BANNED
}

enum HotelStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
}

enum RoomStatus {
  AVAILABLE
  BOOKED
  OCCUPIED
  MAINTENANCE
}

enum BedType {
  SINGLE
  DOUBLE
  QUEEN
  KING
  TWIN
  BUNK
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique @db.VarChar(255)
  passwordHash    String?         @map("password_hash") @db.VarChar(255)
  role            Role            @default(USER)
  status          UserStatus      @default(PENDING)
  loginAttempts   Int             @default(0) @map("login_attempts")
  lockUntil       DateTime?       @map("lock_until")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  profile         UserProfile?
  agentProfile    AgentProfile?
  refreshTokens   RefreshToken[]
  bookings        Booking[]
  bookingLocks    BookingLock[]
  reviews         Review[]
  notifications   Notification[]
  searchHistories SearchHistory[]

  @@map("users")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  fullName    String   @map("full_name") @db.VarChar(100)
  phoneNumber String?  @unique @map("phone_number") @db.VarChar(15)
  avatarUrl   String?  @map("avatar_url") @db.Text
  address     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model AgentProfile {
  userId          String     @id @map("user_id") @db.Uuid
  businessName    String     @map("business_name") @db.VarChar(150)
  businessLicense String?    @map("business_license") @db.Text
  taxCode         String?    @map("tax_code") @db.VarChar(50)
  idNumber        String?    @map("id_number")
  idCardImageUrl  String?    @map("id_card_image_url")
  approvalStatus  UserStatus @default(PENDING) @map("approval_status")
  approvedAt      DateTime?  @map("approved_at")
  rejectedReason  String?    @map("rejected_reason") @db.Text
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotels Hotel[]

  @@map("agent_profiles")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @map("token_hash") @db.VarChar(255)
  deviceName   String?   @map("device_name") @db.VarChar(100)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.Text
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason") @db.VarChar(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Hotel {
  id                   String               @id @default(uuid()) @db.Uuid
  ownerId              String               @db.Uuid
  name                 String               @db.VarChar(255)
  slug                 String               @unique @db.VarChar(255)
  description          String?              @db.Text
  address              String               @db.Text
  city                 String               @db.VarChar(100)
  country              String               @default("Vietnam") @db.VarChar(100)
  latitude             Decimal?             @db.Decimal(10, 8)
  longitude            Decimal?             @db.Decimal(11, 8)
  phone                String?              @db.VarChar(20)
  email                String?              @db.VarChar(255)
  thumbnail            String?              @db.Text
  rating               Float                @default(0)
  checkInTime          String?              @db.VarChar(10)
  checkOutTime         String?              @db.VarChar(10)
  status               HotelStatus          @default(PENDING)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  owner                AgentProfile         @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
  images               HotelImage[]
  rooms                Room[]
  roomTypes            RoomType[]
  bookings             Booking[]
  cancellationPolicies CancellationPolicy[]
  roomInventories      RoomInventory[]
  dailyRevenues        DailyRevenue[]

  @@map("hotels")
}

model HotelImage {
  id        String   @id @default(uuid()) @db.Uuid
  hotelId   String   @db.Uuid
  imageUrl  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("hotel_images")
}

model RoomType {
  id              String          @id @default(uuid()) @db.Uuid
  hotelId         String          @db.Uuid
  name            String          @db.VarChar(150)
  description     String?         @db.Text
  price           Decimal         @db.Decimal(12, 2)
  maxGuests       Int
  maxAdults       Int
  maxChildren     Int
  bedType         BedType
  bedCount        Int
  area            Float?
  thumbnail       String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  hotel           Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms           Room[]
  images          RoomTypeImage[]
  bookingDetails  BookingDetail[]
  roomInventories RoomInventory[]
  bookingLocks    BookingLock[]

  @@unique([hotelId, name])
  @@map("room_types")
}

model Room {
  id                String             @id @default(uuid()) @db.Uuid
  hotelId           String             @db.Uuid
  roomTypeId        String             @db.Uuid
  roomNumber        String             @db.VarChar(30)
  floor             Int?
  status            RoomStatus         @default(AVAILABLE)
  note              String?            @db.Text
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  hotel             Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType          RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  housekeepingTasks HousekeepingTask[]
  maintenanceLogs   MaintenanceLog[]

  @@unique([hotelId, roomNumber])
  @@map("rooms")
}

model RoomTypeImage {
  id         String   @id @default(uuid()) @db.Uuid
  roomTypeId String   @db.Uuid
  imageUrl   String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@map("room_type_images")
}

// ==========================================
// 3. BOOKING SERVICE
// ==========================================
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  hotelId       String        @map("hotel_id") @db.Uuid
  checkInDate   DateTime      @map("check_in_date")
  checkOutDate  DateTime      @map("check_out_date")
  totalPrice    Decimal       @map("total_price") @db.Decimal(12, 2)
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")

  user            User                   @relation(fields: [userId], references: [id])
  hotel           Hotel                  @relation(fields: [hotelId], references: [id])
  details         BookingDetail[]
  guests          Guest[]
  statusHistories BookingStatusHistory[]
  invoices        Invoice[]
  transactions    Transaction[]
  reviews         Review[]

  @@map("bookings")
}

model BookingDetail {
  id         String  @id @default(uuid()) @db.Uuid
  bookingId  String  @map("booking_id") @db.Uuid
  roomTypeId String  @map("room_type_id") @db.Uuid
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  @@map("booking_details")
}

model Guest {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @map("booking_id") @db.Uuid
  fullName  String  @map("full_name") @db.VarChar(150)
  idCard    String? @map("id_card") @db.VarChar(50)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("guests")
}

model BookingStatusHistory {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @map("booking_id") @db.Uuid
  status    BookingStatus
  changedAt DateTime      @default(now()) @map("changed_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_status_histories")
}

model CancellationPolicy {
  id            String @id @default(uuid()) @db.Uuid
  hotelId       String @map("hotel_id") @db.Uuid
  daysBefore    Int    @map("days_before")
  refundPercent Float  @map("refund_percent")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("cancellation_policies")
}

// ==========================================
// 4. PAYMENT SERVICE
// ==========================================
model Invoice {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  taxAmount Decimal  @map("tax_amount") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Transaction {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  gateway   String   @db.VarChar(50)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@map("transactions")
}

model Refund {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model Coupon {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(50)
  discountVal Decimal @map("discount_val") @db.Decimal(12, 2)

  @@map("coupons")
}

// ==========================================
// 5. OPERATION & INVENTORY SERVICE
// ==========================================
enum TaskStatus {
  TODO
  DONE
}

model RoomInventory {
  id          String   @id @default(uuid()) @db.Uuid
  hotelId     String   @map("hotel_id") @db.Uuid
  roomTypeId  String   @map("room_type_id") @db.Uuid
  date        DateTime @db.Date
  totalRooms  Int      @map("total_rooms")
  bookedRooms Int      @default(0) @map("booked_rooms")

  hotel    Hotel    @relation(fields: [hotelId], references: [id])
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  @@unique([hotelId, roomTypeId, date])
  @@map("room_inventories")
}

model BookingLock {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  roomTypeId  String   @map("room_type_id") @db.Uuid
  quantity    Int
  lockedUntil DateTime @map("locked_until")

  user     User     @relation(fields: [userId], references: [id])
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  @@map("booking_locks")
}

model HousekeepingTask {
  id     String     @id @default(uuid()) @db.Uuid
  roomId String     @map("room_id") @db.Uuid
  status TaskStatus @default(TODO)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("housekeeping_tasks")
}

model MaintenanceLog {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  issue     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("maintenance_logs")
}

// ==========================================
// 6. REVIEW & NOTIFICATION SERVICE
// ==========================================
model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id])
  replies ReviewReply[]

  @@map("reviews")
}

model ReviewReply {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  replyText String   @map("reply_text") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_replies")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationTemplate {
  id        Int    @id @default(autoincrement())
  eventName String @map("event_name") @db.VarChar(100)
  htmlBody  String @map("html_body") @db.Text

  @@map("notification_templates")
}

model SearchHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  keyword   String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("search_histories")
}

model DailyRevenue {
  id            String   @id @default(uuid()) @db.Uuid
  hotelId       String   @map("hotel_id") @db.Uuid
  date          DateTime @db.Date
  totalRevenue  Decimal  @map("total_revenue") @db.Decimal(15, 2)
  totalBookings Int      @map("total_bookings")

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, date])
  @@map("daily_revenues")
}
