generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDING
  REFUNDED
}

enum PaymentProvider {
  VNPAY
  STRIPE
}

enum PromotionType {
  PERCENT
  FIXED_AMOUNT
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  bookingCode     String        @unique @map("booking_code") @db.VarChar(50)
  userId          String        @map("user_id") @db.Uuid
  hotelId         String        @map("hotel_id") @db.Uuid
  checkInDate     DateTime      @map("check_in_date") @db.Date
  checkOutDate    DateTime      @map("check_out_date") @db.Date
  totalNights     Int           @map("total_nights")
  
  roomPrice       Decimal       @map("room_price") @db.Decimal(12, 2)
  taxAmount       Decimal       @map("tax_amount") @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalAmount     Decimal       @map("final_amount") @db.Decimal(12, 2)
  
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  rooms             BookingRoom[]
  guestInfo         GuestInfo?
  histories         BookingHistory[]
  paymentTransaction PaymentTransaction?
  invoice           Invoice?
  refundRequests    RefundRequest[]
  appliedPromotion  BookingPromotion?

  @@map("bookings")
}

model BookingRoom {
  id            String  @id @default(uuid()) @db.Uuid
  bookingId     String  @map("booking_id") @db.Uuid
  roomId        String  @map("room_id") @db.Uuid
  roomName      String  @map("room_name") @db.VarChar(255)
  pricePerNight Decimal @map("price_per_night") @db.Decimal(12, 2)
  quantity      Int     @default(1)

  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_rooms")
}

model GuestInfo {
  id              String  @id @default(uuid()) @db.Uuid
  bookingId       String  @unique @map("booking_id") @db.Uuid
  fullName        String  @map("full_name") @db.VarChar(100)
  email           String  @db.VarChar(255)
  phoneNumber     String  @map("phone_number") @db.VarChar(20)
  specialRequests String? @map("special_requests") @db.Text

  booking         Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("guest_info")
}

model BookingHistory {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  action    String   @db.VarChar(100)
  note      String?  @db.Text
  createdBy String?  @map("created_by") @db.Uuid // Có thể là system hoặc userId
  createdAt DateTime @default(now()) @map("created_at")

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_histories")
}

model PaymentTransaction {
  id            String          @id @default(uuid()) @db.Uuid
  bookingId     String          @unique @map("booking_id") @db.Uuid
  transactionId String?         @map("transaction_id") @db.VarChar(255) // ID từ VNPay/Stripe
  provider      PaymentProvider
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("VND") @db.VarChar(10)
  status        String          @db.VarChar(50) // SUCCESS, FAILED, PENDING
  rawData       Json?           @map("raw_data") // Lưu toàn bộ payload webhook
  createdAt     DateTime        @default(now()) @map("created_at")

  booking       Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  bookingId     String   @unique @map("booking_id") @db.Uuid
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(50)
  pdfUrl        String?  @map("pdf_url") @db.Text
  issuedAt      DateTime @default(now()) @map("issued_at")

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Promotion {
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @unique @db.VarChar(50)
  description   String?       @db.Text
  discountType  PromotionType @map("discount_type")
  discountValue Decimal       @map("discount_value") @db.Decimal(12, 2)
  minOrderValue Decimal?      @map("min_order_value") @db.Decimal(12, 2)
  maxDiscount   Decimal?      @map("max_discount") @db.Decimal(12, 2)
  startDate     DateTime      @map("start_date")
  endDate       DateTime      @map("end_date")
  usageLimit    Int?          @map("usage_limit")
  usedCount     Int           @default(0) @map("used_count")
  isActive      Boolean       @default(true) @map("is_active")

  bookings      BookingPromotion[]

  @@map("promotions")
}

model BookingPromotion {
  id          String @id @default(uuid()) @db.Uuid
  bookingId   String @unique @map("booking_id") @db.Uuid
  promotionId String @map("promotion_id") @db.Uuid

  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@map("booking_promotions")
}

model RefundRequest {
  id          String       @id @default(uuid()) @db.Uuid
  bookingId   String       @map("booking_id") @db.Uuid
  amount      Decimal      @db.Decimal(12, 2)
  reason      String       @db.Text
  status      RefundStatus @default(PENDING)
  processedAt DateTime?    @map("processed_at")
  adminNote   String?      @map("admin_note") @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("refund_requests")
}

model CancellationPolicy {
  id                 String  @id @default(uuid()) @db.Uuid
  hotelId            String  @map("hotel_id") @db.Uuid
  daysBeforeCheckIn  Int     @map("days_before_check_in")
  refundPercentage   Decimal @map("refund_percentage") @db.Decimal(5, 2) // e.g. 100.00, 50.00
  
  @@map("cancellation_policies")
}
