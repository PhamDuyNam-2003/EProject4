generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Hotel {
  id            String      @id @default(uuid()) @db.Uuid
  ownerId       String      @db.Uuid // Chỉ lưu UUID tham chiếu tới AgentProfile ở identity-service
  name          String      @db.VarChar(255)
  slug          String      @unique @db.VarChar(255)
  description   String?     @db.Text
  address       String      @db.Text
  city          String      @db.VarChar(100)
  country       String      @default("Vietnam") @db.VarChar(100)
  latitude      Decimal?    @db.Decimal(10,8)
  longitude     Decimal?    @db.Decimal(11,8)
  phone         String?     @db.VarChar(20)
  email         String?     @db.VarChar(255)
  thumbnail     String?     @db.Text
  amenities     String[]    @default([])
  rating        Float       @default(0)
  checkInTime   String?     @db.VarChar(10)
  checkOutTime  String?     @db.VarChar(10)
  status        HotelStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  propertyType  PropertyType @default(HOTEL) @map("property_type")
  
  images        HotelImage[]
  rooms         Room[]
  roomTypes     RoomType[]
  
  
  @@map("hotels")
}

model HotelImage {
  id         String   @id @default(uuid()) @db.Uuid
  hotelId    String   @db.Uuid
  imageUrl   String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  
  @@map("hotel_images")
}

model RoomType {
  id            String    @id @default(uuid()) @db.Uuid
  hotelId       String    @db.Uuid
  name          String    @db.VarChar(150)
  description   String?   @db.Text
  price         Decimal   @db.Decimal(12,2)
  maxGuests     Int
  maxAdults     Int
  maxChildren   Int
  bedType       BedType
  bedCount      Int
  area          Float?
  thumbnail     String?   @db.Text
  isActive      Boolean   @default(true)
  amenities     String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms         Room[]
  images        RoomTypeImage[]
  
  
  @@unique([hotelId, name])
  @@map("room_types")
}


model Room {
  id            String      @id @default(uuid()) @db.Uuid
  hotelId       String      @db.Uuid
  roomTypeId    String      @db.Uuid
  roomNumber    String      @db.VarChar(30)
  floor         Int?
  status        RoomStatus  @default(AVAILABLE)
  note          String?     @db.Text
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  hotel         Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType      RoomType    @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  
  @@unique([hotelId, roomNumber])
  @@map("rooms")
}


model RoomTypeImage {
  id          String    @id @default(uuid()) @db.Uuid
  roomTypeId  String    @db.Uuid
  imageUrl    String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  roomType    RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  
  @@map("room_type_images")
}

enum HotelStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
}

enum RoomStatus {
  AVAILABLE
  BOOKED
  OCCUPIED
  MAINTENANCE
}

enum BedType {
  SINGLE
  DOUBLE
  QUEEN
  KING
  TWIN
  BUNK
}

enum PropertyType {
  HOTEL         
  RESORT       
  VILLA         
  APARTMENT   
  HOMESTAY      
  GUESTHOUSE    
  MOTEL         
  CAMPING      
  GLAMPING      
  CRUISE        
  ENTIRE_HOUSE 
}