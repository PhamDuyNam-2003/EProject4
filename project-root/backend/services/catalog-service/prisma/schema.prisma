datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Hotel {
  id                  String   @id @default(uuid())
  name                String
  city                String
  district            String
  address             String
  description         String?
  price               Float
  rating              Float    @default(5.0)
  reviewScore         Float    @default(9.0)
  reviewCount         Int      @default(0)
  category            String
  distanceToCenter    Float
  nearPublicTransport Boolean  @default(false)
  petFriendly         Boolean  @default(false)
  maxAdults           Int      @default(2)
  maxKids             Int      @default(0)
  bedrooms            Int      @default(1)
  amenities           String[]
  roomFeatures        String[]
  policies            String[]
  images              String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}